enum BannerActionType {
  NONE
  CATEGORY
  PRODUCT
  BRAND
  FILTER
  PAGE
}

model Banner {
  id         Int      @id @default(autoincrement())
  title      String?
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  images BannerImage[]
}

model BannerImage {
  id                 Int             @id @default(autoincrement())
  banner_id          Int
  image_url          String
  sort_order         Int             @default(0)
  click_action_type  BannerActionType @default(NONE)
  click_target_id    Int?
  click_target_data  Json?
  created_at         DateTime        @default(now())

  banner Banner @relation(fields: [banner_id], references: [id], onDelete: Cascade)

  @@index([banner_id])
}
